// ============================================================
// nextflow.config — Genome Analysis パイプライン設定 / configuration
//   ~ の代わりに env('HOME') で絶対パスを組み立てます（新構文対応）。
//   Paths use env('HOME') so they resolve to an absolute path (strict-syntax safe).
// ============================================================

params {
    // --- 入力サンプルシート（TSV）/ input sample sheet ---
    //   列 / columns: sample  type(tumor|normal)  fq1  fq2
    samples = "samples.tsv"

    // --- 出力先 / output root ---
    outdir  = "${env('HOME')}/pipeline_res/nextflow"

    // --- 参照ゲノム・インデックス / reference & index ---
    ref       = "${env('HOME')}/data/ref/hg19/hg19.fa"
    bwa_index = "${env('HOME')}/data/ref/hg19/bwa_index/hg19_bwa"

    // --- BQSR 既知サイト / known sites ---
    known_sites = [
        "${env('HOME')}/data/vcf/1000G_omni2.5.hg19.sites.vcf",
        "${env('HOME')}/data/vcf/1000G_phase1.indels.hg19.sites.vcf",
        "${env('HOME')}/data/vcf/Mills_and_1000G_gold_standard.indels.hg19.sites.vcf",
        "${env('HOME')}/data/vcf/dbsnp_138.hg19.vcf",
    ]

    // --- Mutect2 リソース / Mutect2 resources ---
    germline_resource = "${env('HOME')}/data/vcf/af-only-gnomad.raw.sites.chr.vcf"
    intervals         = "${env('HOME')}/data/dna/braf_hg19_exon15.bed"

    // --- 実行パラメータ / runtime ---
    threads  = 4
    java_mem = "-Xmx10g"

    // --- fastp パラメータ / fastp parameters ---
    fastp = [ n: 10, l: 15, q: 20, t: 1, T: 1, w: 4 ]
}

// 既定のプロセス設定 / default process resources
process {
    cpus = params.threads
}

// 実行プロファイル / execution profiles
//   -profile conda  : 各プロセスの conda 環境を自動構築 / build per-process conda envs
//   -profile docker : （任意）コンテナで実行 / run in containers (optional)
profiles {
    standard { conda.enabled = false }
    conda {
        conda.enabled = true
        conda.useMamba = true          // mamba があれば高速化 / faster if mamba is present
    }
    docker {
        docker.enabled = true
    }
}

// 実行レポート / run reports
report  { enabled = true; overwrite = true; file = "${params.outdir}/reports/report.html" }
timeline{ enabled = true; overwrite = true; file = "${params.outdir}/reports/timeline.html" }
dag     { enabled = true; overwrite = true; file = "${params.outdir}/reports/dag.html" }
